        // ==========================================
        // EMBED EXACT DPI HEADER IN JPEG / PNG
        // (Ensures MS Word / Photoshop reads exact 5x5 cm size!)
        // ==========================================
        function setDpiInDataUrl(dataUrl, dpi) {
            if (dataUrl.startsWith('data:image/jpeg')) {
                // Modify JFIF header density bytes so apps recognize exact physical 5x5 cm
                const base64 = dataUrl.split(',')[1];
                const raw = atob(base64);
                const bytes = new Uint8Array(raw.length);
                for (let i = 0; i < raw.length; i++) {
                    bytes[i] = raw.charCodeAt(i);
                }
                // Check JFIF marker at offset 2..17
                if (bytes[2] === 0xFF && bytes[3] === 0xE0 && bytes[6] === 0x4A && bytes[7] === 0x46) {
                    bytes[13] = 1; // 1 = dots per inch
                    bytes[14] = (dpi >> 8) & 0xFF;
                    bytes[15] = dpi & 0xFF;
                    bytes[16] = (dpi >> 8) & 0xFF;
                    bytes[17] = dpi & 0xFF;
                }
                let binary = '';
                for (let i = 0; i < bytes.length; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                return 'data:image/jpeg;base64,' + btoa(binary);
            }
            return dataUrl;
        }

        function getFormattedPhotoDataUrl(photo) {
            const canvas = document.getElementById(`canvas-${photo.id}`) || document.createElement('canvas');
            renderPhotoToSquareCanvas(photo, canvas);
            const mime = document.getElementById('formatSelect').value;
            const rawDataUrl = canvas.toDataURL(mime, 0.94);
            return setDpiInDataUrl(rawDataUrl, getSelectedDpi());
        }

        // ==========================================
        // EXPORT 1: SINGLE PHOTO DOWNLOAD
        // ==========================================
        function downloadSinglePhoto(id) {
            const photo = photos.find(p => p.id === id);
            if (!photo) return;

            const mime = document.getElementById('formatSelect').value;
            const ext = mime === 'image/png' ? 'png' : 'jpg';
            const dataUrl = getFormattedPhotoDataUrl(photo);

            const safeName = (photo.caption || photo.name).replace(/[^a-zA-Z0-9_\-\.]/g, '_');
            const link = document.createElement('a');
            link.href = dataUrl;
            link.download = `${safeName}_5x5cm.${ext}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showToast(`Foto "${photo.name}" (5×5 cm) berhasil diunduh`);
        }

        // ==========================================
        // EXPORT 2: DOWNLOAD ALL AS .ZIP
        // ==========================================
        async function downloadAllAsZip() {
            if (photos.length === 0) return;

            const btn = document.getElementById('btnDownloadZip');
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> <span>Memproses ZIP...</span>`;
            lucide.createIcons();

            try {
                const zip = new JSZip();
                const folder = zip.folder("Lampiran_Foto_5x5cm");
                const mime = document.getElementById('formatSelect').value;
                const ext = mime === 'image/png' ? 'png' : 'jpg';

                photos.forEach((photo, idx) => {
                    const dataUrl = getFormattedPhotoDataUrl(photo);
                    const base64Data = dataUrl.split(',')[1];
                    const numPrefix = String(idx + 1).padStart(2, '0');
                    const safeTitle = (photo.name || `Foto_${idx + 1}`).replace(/[^a-zA-Z0-9_\-]/g, '_');
                    folder.file(`${numPrefix}_${safeTitle}_5x5cm.${ext}`, base64Data, { base64: true });
                });

                const blob = await zip.generateAsync({ type: 'blob' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Lampiran_Foto_5x5cm_${photos.length}_Foto.zip`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                showToast(`${photos.length} foto ukuran 5×5 cm berhasil diunduh dalam file .ZIP!`);
            } catch (err) {
                console.error(err);
                showToast('Terjadi kendala saat membuat file ZIP.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                lucide.createIcons();
            }
        }

