        // Core renderer that draws a photo onto a target square canvas (5x5 cm proportion)
        function renderPhotoToSquareCanvas(photo, canvas) {
            const size = getTargetPixels();
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');

            // 1. Fill clean white background (essential for JPG & Fit mode)
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, size, size);

            const borderType = document.getElementById('borderSelect').value;
            const pad = (borderType === 'frame') ? Math.round(size * 0.035) : 0;
            const drawArea = size - pad * 2;

            ctx.save();
            // Clip to inner draw area
            ctx.beginPath();
            ctx.rect(pad, pad, drawArea, drawArea);
            ctx.clip();

            // Move origin to center of canvas for rotation & scaling
            ctx.translate(size / 2, size / 2);
            ctx.rotate((photo.rotation * Math.PI) / 180);

            const isRotated90 = (photo.rotation % 180 !== 0);
            const srcW = isRotated90 ? photo.origHeight : photo.origWidth;
            const srcH = isRotated90 ? photo.origWidth : photo.origHeight;

            let drawW, drawH;

            if (photo.fitMode === 'stretch') {
                drawW = drawArea * photo.zoom;
                drawH = drawArea * photo.zoom;
            } else if (photo.fitMode === 'contain') {
                const scale = Math.min(drawArea / srcW, drawArea / srcH) * photo.zoom;
                drawW = srcW * scale;
                drawH = srcH * scale;
            } else {
                // Default 'cover' (Crop Tengah 5x5 cm)
                const scale = Math.max(drawArea / srcW, drawArea / srcH) * photo.zoom;
                drawW = srcW * scale;
                drawH = srcH * scale;
            }

            // Calculate pan offset in rotated space
            const maxOffsetX = Math.max(0, (drawW - drawArea) / 2);
            const maxOffsetY = Math.max(0, (drawH - drawArea) / 2);
            const offsetX = photo.panX * maxOffsetX;
            const offsetY = photo.panY * maxOffsetY;

            // Un-rotate offset so dragging matches screen direction
            const rad = (-photo.rotation * Math.PI) / 180;
            const rotOffsetX = offsetX * Math.cos(rad) - offsetY * Math.sin(rad);
            const rotOffsetY = offsetX * Math.sin(rad) + offsetY * Math.cos(rad);

            const imgDrawW = isRotated90 ? drawH : drawW;
            const imgDrawH = isRotated90 ? drawW : drawH;

            ctx.drawImage(
                photo.imgElement,
                -imgDrawW / 2 + rotOffsetX,
                -imgDrawH / 2 + rotOffsetY,
                imgDrawW,
                imgDrawH
            );

            ctx.restore();

            // Optional: Burn Caption inside bottom of photo if checked
            const burnCaption = document.getElementById('burnCaptionCheck').checked;
            if (burnCaption && photo.caption.trim() !== '') {
                const barH = Math.max(24, Math.round(size * 0.11));
                ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
                ctx.fillRect(pad, size - pad - barH, drawArea, barH);

                ctx.fillStyle = '#ffffff';
                const fontSize = Math.max(10, Math.round(size * 0.036));
                ctx.font = `600 ${fontSize}px Inter, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(photo.caption.trim(), size / 2, size - pad - barH / 2, drawArea - 16);
            }

            // Draw Border if selected
            if (borderType === 'thin-black') {
                const bw = Math.max(2, Math.round(size * 0.005));
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = bw;
                ctx.strokeRect(bw / 2, bw / 2, size - bw, size - bw);
            } else if (borderType === 'gray') {
                const bw = Math.max(2, Math.round(size * 0.005));
                ctx.strokeStyle = '#94a3b8';
                ctx.lineWidth = bw;
                ctx.strokeRect(bw / 2, bw / 2, size - bw, size - bw);
            } else if (borderType === 'frame') {
                const bw = Math.max(2, Math.round(size * 0.005));
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = bw;
                ctx.strokeRect(bw / 2, bw / 2, size - bw, size - bw);
                ctx.strokeStyle = '#cbd5e1';
                ctx.lineWidth = Math.max(1, Math.round(size * 0.003));
                ctx.strokeRect(pad, pad, drawArea, drawArea);
            }
        }

        function drawPhotoOnCanvas(photo) {
            const canvas = document.getElementById(`canvas-${photo.id}`);
            if (!canvas) return;
            renderPhotoToSquareCanvas(photo, canvas);
        }

